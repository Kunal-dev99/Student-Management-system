  "cards": [
    {
      "dot": "cyan",
      "title": "How a change is recorded",
      "items": [
        "Each fact (status, programme, intensity and more) is a run of periods: valid_from to valid_to",
        "A change closes the covering period with a closed copy and opens a new one; nothing is edited in place",
        "A back-dated change only runs until the next recorded change, so later history is never overwritten",
        "correct() fixes a wrong record: the wrong row stays, superseded by a fixed copy"
      ]
    },
    {
      "dot": "amber",
      "title": "Today vs history",
      "items": [
        "Screens read the cached value on the student row, which always matches the period covering today",
        "A future-dated change is stored now; the scheduler moves the cache when its date arrives"
      ]
    },
    {
      "dot": "rose",
      "title": "Protecting signed-off returns",
      "items": [
        "Before approval: a warning names any signed-off return the change would reach",
        "At approval: a change dated inside a signed-off year needs the amend permission",
        "After: retrospective-changes lists what moved inside the year since sign-off",
        "Intensity changes also run the FTE vs module FTE check (warn or stop)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reading the past",
      "items": [
        "as_at: the value each fact had on that date",
        "known_at: only what had been recorded by that moment, so an old return can be rebuilt exactly"
      ]
    }
  ]
