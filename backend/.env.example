# PGR Platform backend — environment (arch Appendix C)
APP_ENV=dev                      # dev | staging | production
APP_SECRET_KEY=change-me-in-prod # signing key for tokens

# Database. Production uses async PostgreSQL 16. For a local boot WITHOUT Postgres,
# the default in config.py falls back to async SQLite so `uvicorn` runs out of the box.
DATABASE_URL=postgresql+asyncpg://pgr:pgr@localhost:5432/pgr
DATABASE_REPLICA_URL=            # optional read-replica DSN

REDIS_URL=redis://localhost:6379/0
BROKER_URL=redis://localhost:6379/1

OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=pgr-documents

# Phase 4A — file storage (documents). local writes under STORAGE_ROOT; s3 is a later swap.
STORAGE_BACKEND=local            # local | s3
STORAGE_ROOT=./var/storage
MAX_UPLOAD_MB=50

# Phase 4A — email. console logs the message (dev); smtp sends via aiosmtplib (prod).
EMAIL_BACKEND=console            # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=PGR Platform <no-reply@pgr.local>
APP_BASE_URL=http://localhost:3000   # used in links inside emails (password reset)

# Phase 4A — background worker cadence (seconds) + outbox retry cap.
WORKER_SCHEDULER_INTERVAL_SECONDS=60
WORKER_DISPATCH_INTERVAL_SECONDS=20
WORKER_NOTIFY_INTERVAL_SECONDS=30
OUTBOX_MAX_ATTEMPTS=5

# Phase 4A — auth hardening.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_SECONDS=3600

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

INTEGRATION_FINANCE_URL=
INTEGRATION_RESEARCH_URL=
INTEGRATION_HR_URL=

# Phase 5 — "Ask PGR" assistant.
# The assistant runs on an on-premise RULE-BASED intent parser by default: cohort questions,
# lookups, navigation and pinned intents are answered with zero tokens and NO student data
# leaving the server. Unrecognised phrasings decline honestly with suggestions.
#
# The LLM fallback is OPT-IN. Turn it on only if you want open paraphrase ("who's falling
# through the cracks?") and multi-hop reasoning, and accept that record content is then sent
# to a third-party API (a GDPR consideration for personal data).
ASSISTANT_LLM_ENABLED=false
ANTHROPIC_API_KEY=

SENTRY_DSN=
OTEL_EXPORTER_ENDPOINT=
LOG_LEVEL=info                   # info | debug | warning
