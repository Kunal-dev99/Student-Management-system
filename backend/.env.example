# PGR Platform backend — environment (arch Appendix C)
APP_ENV=dev                      # dev | staging | production
APP_SECRET_KEY=change-me-in-prod # signing key for tokens

# Database. Production uses async PostgreSQL 16. For a local boot WITHOUT Postgres,
# the default in config.py falls back to async SQLite so `uvicorn` runs out of the box.
DATABASE_URL=postgresql+asyncpg://pgr:pgr@localhost:5432/pgr
DATABASE_REPLICA_URL=            # optional read-replica DSN

REDIS_URL=redis://localhost:6379/0
BROKER_URL=redis://localhost:6379/1

OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=pgr-documents

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

INTEGRATION_FINANCE_URL=
INTEGRATION_RESEARCH_URL=
INTEGRATION_HR_URL=

SENTRY_DSN=
OTEL_EXPORTER_ENDPOINT=
LOG_LEVEL=info                   # info | debug | warning
